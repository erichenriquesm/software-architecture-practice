{
  "name": "@trading/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "contracts",
    "libs/*",
    "architecture",
    "service-template",
    "infra/verify"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "TEST_SUITE=unit vitest run",
    "check": "npm run proto:gen -w @trading/contracts --if-present && npm run typecheck && npm run lint && npm run test:unit",
    "arch": "vitest run --project architecture",
    "scaffold": "node scripts/scaffold.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15"
  }
}
