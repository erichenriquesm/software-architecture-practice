ACCOUNT_RABBITMQ_PASSWORD=account-rabbitmq-dev
WALLET_RABBITMQ_PASSWORD=wallet-rabbitmq-dev
ORDER_RABBITMQ_PASSWORD=order-rabbitmq-dev
MATCHING_RABBITMQ_PASSWORD=matching-rabbitmq-dev
MARKET_DATA_RABBITMQ_PASSWORD=market-data-rabbitmq-dev

ACCOUNT_REDIS_PASSWORD=account-redis-dev
WALLET_REDIS_PASSWORD=wallet-redis-dev
ORDER_REDIS_PASSWORD=order-redis-dev
MARKET_DATA_REDIS_PASSWORD=market-data-redis-dev
