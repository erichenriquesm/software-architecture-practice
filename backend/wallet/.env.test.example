# Ephemeral containers of docker-compose.test.yml. Copy to .env.test: cp .env.test.example .env.test
POSTGRES_PASSWORD=test
RABBITMQ_DEFAULT_USER=test
RABBITMQ_DEFAULT_PASS=test
TEST_DATABASE_URL=postgres://postgres:test@wallet-db-test:5432/postgres
TEST_RABBITMQ_URL=amqp://test:test@wallet-rabbitmq-test:5672
TEST_REDIS_URL=redis://wallet-redis-test:6379
