{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading.local/contracts/order.voided.v1.schema.json",
  "title": "order.voided v1 payload",
  "type": "object",
  "required": [
    "orderId",
    "accountId",
    "marketId",
    "side",
    "quantity",
    "price",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "marketId": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}-[A-Z]{3,5}$"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ]
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    },
    "reason": {
      "enum": [
        "EXPIRED",
        "CANCELLED"
      ]
    }
  }
}
