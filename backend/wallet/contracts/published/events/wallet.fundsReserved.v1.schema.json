{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading.local/contracts/wallet.fundsReserved.v1.schema.json",
  "title": "wallet.fundsReserved v1 payload",
  "type": "object",
  "required": [
    "orderId",
    "accountId",
    "assetId",
    "amount"
  ],
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "assetId": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    }
  }
}
