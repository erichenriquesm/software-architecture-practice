{
  "name": "@trading/contracts",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./grpc/account": {
      "source": "./generated/account.ts",
      "types": "./dist/generated/account.d.ts",
      "default": "./dist/generated/account.js"
    },
    "./grpc/wallet": {
      "source": "./generated/wallet.ts",
      "types": "./dist/generated/wallet.d.ts",
      "default": "./dist/generated/wallet.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.6"
  },
  "devDependencies": {
    "ts-proto": "2.18.3"
  }
}
