# Development values for the containers in docker/docker-compose.yml. Copy to .env: cp .env.example .env
# matching has no public API (only /health on the worker), no Redis and no gRPC.
HEALTH_PORT=3001

DATABASE_HOST=matching-db
DATABASE_PORT=5432
DATABASE_NAME=matching
# One user per service: it owns the database, runs the migrations and reads/writes the data
DATABASE_USER=matching
DATABASE_PASSWORD=matching-db-dev

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=matching
RABBITMQ_PASSWORD=matching-rabbitmq-dev

LOG_LEVEL=debug
