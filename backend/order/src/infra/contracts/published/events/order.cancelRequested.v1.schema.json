{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading.local/contracts/order.cancelRequested.v1.schema.json",
  "title": "order.cancelRequested v1 payload",
  "type": "object",
  "required": [
    "orderId",
    "marketId"
  ],
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "marketId": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}-[A-Z]{3,5}$"
    }
  }
}
