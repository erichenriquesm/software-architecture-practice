  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "INSUFFICIENT_FUNDS",
        "WALLET_NOT_FOUND"
      ]
    }
  }
}
