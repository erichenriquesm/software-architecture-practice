# Development values for the containers in docker/docker-compose.yml. Copy to .env: cp .env.example .env
API_PORT=3000
HEALTH_PORT=3001

DATABASE_HOST=order-db
DATABASE_PORT=5432
DATABASE_NAME=order
# One user per service: it owns the database, runs the migrations and reads/writes the data
DATABASE_USER=order
DATABASE_PASSWORD=order-db-dev

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=order
RABBITMQ_PASSWORD=order-rabbitmq-dev

REDIS_HOST=redis
REDIS_USER=order
REDIS_PASSWORD=order-redis-dev

# Saga S2: a pending order not reserved by the wallet within this time expires
ORDER_PENDING_TIMEOUT=2m
EXPIRE_PENDING_ORDERS_INTERVAL=10s

RATE_LIMITS_ORDERS_PER_IP=100/10s
RATE_LIMITS_ORDERS_PER_ACCOUNT=50/10s
RATE_LIMITS_ORDERS_PER_ACCOUNT_DAILY=100000/24h
RATE_LIMITS_PRIVATE_READ_PER_IP=600/1m
RATE_LIMITS_PRIVATE_READ_PER_ACCOUNT=300/1m

LOG_LEVEL=debug
