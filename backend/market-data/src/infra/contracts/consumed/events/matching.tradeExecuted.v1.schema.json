{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading.local/contracts/matching.tradeExecuted.v1.schema.json",
  "title": "matching.tradeExecuted v1 payload",
  "type": "object",
  "required": [
    "tradeId",
    "marketId",
    "buyOrderId",
    "sellOrderId",
    "buyAccountId",
    "sellAccountId",
    "side",
    "quantity",
    "price",
    "executedAt",
    "bookSequence"
  ],
  "additionalProperties": false,
  "properties": {
    "tradeId": {
      "type": "string",
      "format": "uuid"
    },
    "marketId": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}-[A-Z]{3,5}$"
    },
    "buyOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "sellOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "buyAccountId": {
      "type": "string",
      "format": "uuid"
    },
    "sellAccountId": {
      "type": "string",
      "format": "uuid"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "bookSequence": {
      "type": "integer",
      "minimum": 1
    }
  }
}
