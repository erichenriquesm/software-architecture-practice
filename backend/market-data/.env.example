# Development values for the containers in docker/docker-compose.yml. Copy to .env: cp .env.example .env
API_PORT=3000
HEALTH_PORT=3001

DATABASE_HOST=market-data-db
DATABASE_PORT=5432
DATABASE_NAME=market_data
# One user per service: it owns the database, runs the migrations and reads/writes the data
DATABASE_USER=market_data
DATABASE_PASSWORD=market-data-db-dev

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=marketData
RABBITMQ_PASSWORD=market-data-rabbitmq-dev

REDIS_HOST=redis
REDIS_USER=marketData
REDIS_PASSWORD=market-data-redis-dev

RATE_LIMITS_PUBLIC_READ_PER_IP=1200/1m

# Projection rebuild: the stream is considered fully replayed after this long without a message
REBUILD_IDLE_TIMEOUT=2s

LOG_LEVEL=debug
