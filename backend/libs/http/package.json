{
  "name": "@trading/http",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b"
  },
  "exports": {
    "./rate-limit": {
      "source": "./src/rateLimit/index.ts",
      "types": "./dist/rateLimit/index.d.ts",
      "default": "./dist/rateLimit/index.js"
    },
    "./idempotency": {
      "source": "./src/idempotency/index.ts",
      "types": "./dist/idempotency/index.d.ts",
      "default": "./dist/idempotency/index.js"
    },
    "./errors": {
      "source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./sql/*": "./sql/*"
  },
  "dependencies": {
    "@trading/resilience": "*",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "kysely": "0.29.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@trading/testing": "*",
    "@types/pg": "8.23.1"
  }
}
