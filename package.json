{
  "name": "software-architecture",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/infra/index.ts",
    "start:dev": "tsx src/infra/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/infra/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docker:build": "docker build -t software-architecture .",
    "docker:run": "docker run --rm software-architecture",
    "start": "npm run build && npm run docker:run"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.19.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "~0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  }
}
